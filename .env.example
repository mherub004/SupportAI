# scripts/configure.py creates random local credentials. Never commit .env.
OPERATOR_TOKEN=CHANGE_ME_OPERATOR
POSTGRES_PASSWORD=CHANGE_ME_DATABASE
CONNECTOR_MODE=demo
MAILBOX=support@example.invalid
AUTO_SEND_ENABLED=false
PRODUCTION_APPROVED=false
AUTO_SEND_CATEGORIES=manual_link
HOURLY_SEND_LIMIT=10
RETENTION_DAYS=30
# Compose sets DATABASE_URL for its internal database. Local script uses SQLite.
DATABASE_URL=sqlite:///./supportflow.db
API_URL=http://127.0.0.1:8000
DASHBOARD_ORIGIN=http://localhost:3000
# Set true behind HTTPS before exposing the dashboard.
COOKIE_SECURE=false
GMAIL_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=
# Host OAuth Web client: enables the Personal setup Connect Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional CRM integrations. Keep secrets on the backend host.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
NETSUITE_CLIENT_ID=
NETSUITE_CLIENT_SECRET=
NETSUITE_ACCOUNT_ID=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
GMAIL_TOPIC=
DRIVE_FOLDER_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: set a separate random key BEFORE saving any integration credentials.
# Keep it stable; changing the key requires migrating/re-entering saved credentials.
CONNECTOR_ENCRYPTION_KEY=

# Local demo callback origin. For custom domains / Workers, use the dashboard origin.
# Render does not copy this file into its image and supplies its own public origin automatically.
PUBLIC_APP_URL=http://localhost:3000
